+class Workspace(Protocol):
+    """A run-scoped filesystem, independent of harness conversation capture."""
+
+    path: Path
+    digest_before: str
+    digest_after: str | None
+
+    def __enter__(self) -> Workspace: ...
+    def __exit__(self, exc_type: Any, exc_value: Any, traceback: Any) -> None: ...
+
+    @property
+    def integrity_error(self) -> str | None: ...
+
+
+class SnapshotWorkspace:
+    """Temporary read-only export of the repositories pinned in the manifest."""
+
+    def __init__(self, repos: dict[str, dict], task: dict):
+        self.repos = repos
+        self.task = task
+        self._temporary: tempfile.TemporaryDirectory[str] | None = None
+        self.path: Path
+        self.digest_before = ""
+        self.digest_after: str | None = None
+
+    def __enter__(self) -> SnapshotWorkspace:
+        self._temporary = tempfile.TemporaryDirectory(prefix="agent-eval-")
+        self.path = Path(self._temporary.name) / "workspace"
+        try:
+            prepare_workspace(self.repos, self.task, self.path)
+            self.digest_before = tree_digest(self.path)
+        except BaseException:
+            self._temporary.cleanup()
+            self._temporary = None
+            raise
+        return self
+
+    def __exit__(self, exc_type: Any, exc_value: Any, traceback: Any) -> None:
+        try:
+            if self.path.exists():
+                self.digest_after = tree_digest(self.path)
+        finally:
+            if self._temporary is not None:
+                self._temporary.cleanup()
+                self._temporary = None
+
+    @property
+    def integrity_error(self) -> str | None:
+        if self.digest_after != self.digest_before:
+            return "Repository snapshot was modified"
+        return None
+
+
+def create_workspace(repos: dict[str, dict], task: dict) -> Workspace:
+    """Create the default run workspace; alternative implementations can use this seam."""
+    return SnapshotWorkspace(repos, task)
