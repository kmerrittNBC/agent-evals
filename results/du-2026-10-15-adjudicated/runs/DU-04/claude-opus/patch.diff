+    def test_digest_tracks_symlink_targets_including_broken_links(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            (root / "a.txt").write_text("same")
+            (root / "b.txt").write_text("same")
+            link = root / "link"
+            link.symlink_to("a.txt")
+            live = tree_digest(root)
+            link.unlink()
+            link.symlink_to("b.txt")
+            self.assertNotEqual(live, tree_digest(root))
+            link.unlink()
+            link.symlink_to("missing-a")
+            broken = tree_digest(root)
+            link.unlink()
+            link.symlink_to("missing-b")
+            self.assertNotEqual(broken, tree_digest(root))
+            link.unlink()
+            link.symlink_to("missing-a")
+            self.assertEqual(broken, tree_digest(root))
+
     def test_no_usage_is_not_zero_credits(self):
