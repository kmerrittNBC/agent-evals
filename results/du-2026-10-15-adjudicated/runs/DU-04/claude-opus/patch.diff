diff --git a/src/agent_eval/core.py b/src/agent_eval/core.py
index 7fdb9d7..c60feee 100644
--- a/src/agent_eval/core.py
+++ b/src/agent_eval/core.py
@@ -234,6 +234,9 @@ def tree_digest(root: Path) -> str:
     digest = hashlib.sha256()
     for path in sorted(root.rglob("*")):
         digest.update(str(path.relative_to(root)).encode())
+        if path.is_symlink():
+            # Hash the link text itself so retargeting (even a dangling link) is detected.
+            digest.update(b"\0symlink\0" + os.fsencode(os.readlink(path)))
         if path.is_file():
             digest.update(path.read_bytes())
     return digest.hexdigest()
