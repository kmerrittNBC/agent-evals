+func TestListTodosCompletedFilter(t *testing.T) {
+	store := newTestStore(t)
+	handler := newAPIHandler(store)
+	for _, value := range []string{"true", "false"} {
+		empty := performRequest[[]Todo](t, handler, http.MethodGet, "/api/todos?completed="+value, "", http.StatusOK)
+		if empty == nil || len(empty) != 0 {
+			t.Fatalf("empty filtered list = %+v, want []", empty)
+		}
+	}
+	for _, body := range []string{
+		`{"title":"open one"}`,
+		`{"title":"done one","completed":true}`,
+		`{"title":"open two"}`,
+		`{"title":"done two","completed":true}`,
+	} {
+		performRequest[Todo](t, handler, http.MethodPost, "/api/todos", body, http.StatusCreated)
+	}
+
+	for _, test := range []struct {
+		path string
+		ids  []int64
+	}{
+		{"/api/todos", []int64{1, 2, 3, 4}},
+		{"/api/todos?completed=true", []int64{2, 4}},
+		{"/api/todos?completed=false", []int64{1, 3}},
+	} {
+		t.Run(test.path, func(t *testing.T) {
+			listed := performRequest[[]Todo](t, handler, http.MethodGet, test.path, "", http.StatusOK)
+			ids := make([]int64, 0, len(listed))
+			for _, todo := range listed {
+				ids = append(ids, todo.ID)
+			}
+			if !reflect.DeepEqual(ids, test.ids) {
+				t.Fatalf("listed IDs = %v, want %v", ids, test.ids)
+			}
+		})
+	}
+
+	for _, path := range []string{
+		"/api/todos?completed=", "/api/todos?completed=maybe",
+		"/api/todos?completed=TRUE", "/api/todos?completed=1",
+		"/api/todos?completed=true&completed=false",
+	} {
+		t.Run(path, func(t *testing.T) {
+			result := performRequest[map[string]string](t, handler, http.MethodGet, path, "", http.StatusBadRequest)
+			if result["error"] == "" {
+				t.Fatal("expected JSON error message")
+			}
+		})
+	}
+
+	// Filtering, including rejected filters, must not modify stored records.
+	listed := performRequest[[]Todo](t, handler, http.MethodGet, "/api/todos", "", http.StatusOK)
+	for i, todo := range listed {
+		if todo.ID != int64(i+1) || todo.Completed != (i%2 == 1) {
+			t.Fatalf("todo changed after filtering: %+v", listed)
+		}
+	}
+}
