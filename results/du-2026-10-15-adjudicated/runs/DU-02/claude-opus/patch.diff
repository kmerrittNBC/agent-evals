+func TestListTodosFiltersByCompleted(t *testing.T) {
+	handler := newAPIHandler(newTestStore(t))
+
+	performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"First open"}`, http.StatusCreated)
+	performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"First done","completed":true}`, http.StatusCreated)
+	performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"Second open"}`, http.StatusCreated)
+	performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"Second done","completed":true}`, http.StatusCreated)
+
+	tests := []struct {
+		path string
+		want []string
+	}{
+		{"/api/todos", []string{"First open", "First done", "Second open", "Second done"}},
+		{"/api/todos?completed=true", []string{"First done", "Second done"}},
+		{"/api/todos?completed=false", []string{"First open", "Second open"}},
+	}
+	for _, test := range tests {
+		listed := performRequest[[]Todo](t, handler, http.MethodGet, test.path, "", http.StatusOK)
+		if got := todoTitles(listed); !slices.Equal(got, test.want) {
+			t.Errorf("GET %s titles = %q, want %q", test.path, got, test.want)
+		}
+	}
+}
+
+func TestListTodosFilterReturnsEmptyArray(t *testing.T) {
+	handler := newAPIHandler(newTestStore(t))
+	performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"Open"}`, http.StatusCreated)
+
+	request := httptest.NewRequest(http.MethodGet, "/api/todos?completed=true", nil)
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	if response.Code != http.StatusOK || strings.TrimSpace(response.Body.String()) != "[]" {
+		t.Fatalf("status = %d, body = %q; want 200 and []", response.Code, response.Body.String())
+	}
+}
+
+func TestListTodosRejectsInvalidCompletedFilter(t *testing.T) {
+	store := newTestStore(t)
+	handler := newAPIHandler(store)
+	performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"Keep me"}`, http.StatusCreated)
+
+	for _, query := range []string{
+		"completed=",
+		"completed=maybe",
+		"completed=TRUE",
+		"completed=1",
+		"completed=0",
+		"completed=true&completed=false",
+	} {
+		body := performRequest[map[string]string](t, handler, http.MethodGet, "/api/todos?"+query, "", http.StatusBadRequest)
+		if body["error"] == "" {
+			t.Errorf("GET /api/todos?%s returned no error message", query)
+		}
+	}
+
+	stored, err := store.List(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := todoTitles(stored); !slices.Equal(got, []string{"Keep me"}) {
+		t.Fatalf("stored todos changed after rejected filters: %q", got)
+	}
+}
