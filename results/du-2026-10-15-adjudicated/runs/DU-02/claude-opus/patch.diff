+// readCompletedFilter parses the optional completed query parameter. It returns
+// nil when the parameter is absent and rejects anything other than a single
+// "true" or "false" value.
+func readCompletedFilter(r *http.Request) (*bool, error) {
+	values, present := r.URL.Query()["completed"]
+	if !present {
+		return nil, nil
+	}
+	if len(values) != 1 {
+		return nil, errInvalidFilter
+	}
+	var completed bool
+	switch values[0] {
+	case "true":
+		completed = true
+	case "false":
+		completed = false
+	default:
+		return nil, errInvalidFilter
+	}
+	return &completed, nil
+}
