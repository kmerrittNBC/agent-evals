+func TestListTodosCanFilterByCompleted(t *testing.T) {
+	handler := newAPIHandler(newTestStore(t))
+	created := []Todo{
+		performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"open first"}`, http.StatusCreated),
+		performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"done first","completed":true}`, http.StatusCreated),
+		performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"open second"}`, http.StatusCreated),
+		performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"done second","completed":true}`, http.StatusCreated),
+	}
+
+	all := performRequest[[]Todo](t, handler, http.MethodGet, "/api/todos", "", http.StatusOK)
+	if len(all) != len(created) {
+		t.Fatalf("unfiltered todo count = %d, want %d", len(all), len(created))
+	}
+	for i, todo := range all {
+		if todo.ID != created[i].ID {
+			t.Errorf("unfiltered todo at index %d has ID %d, want %d", i, todo.ID, created[i].ID)
+		}
+	}
+
+	for _, test := range []struct {
+		query string
+		want  []Todo
+	}{
+		{query: "true", want: []Todo{created[1], created[3]}},
+		{query: "false", want: []Todo{created[0], created[2]}},
+	} {
+		filtered := performRequest[[]Todo](t, handler, http.MethodGet, "/api/todos?completed="+test.query, "", http.StatusOK)
+		if len(filtered) != len(test.want) {
+			t.Fatalf("completed=%s returned %d todos, want %d", test.query, len(filtered), len(test.want))
+		}
+		for i, todo := range filtered {
+			if todo.ID != test.want[i].ID {
+				t.Errorf("completed=%s todo at index %d has ID %d, want %d", test.query, i, todo.ID, test.want[i].ID)
+			}
+		}
+	}
+
+	for _, query := range []string{"maybe", "", "TRUE", "true&completed=false"} {
+		request := httptest.NewRequest(http.MethodGet, "/api/todos?completed="+query, nil)
+		response := httptest.NewRecorder()
+		handler.ServeHTTP(response, request)
+		if response.Code != http.StatusBadRequest {
+			t.Errorf("completed=%q status = %d, want %d", query, response.Code, http.StatusBadRequest)
+		}
+	}
+}
