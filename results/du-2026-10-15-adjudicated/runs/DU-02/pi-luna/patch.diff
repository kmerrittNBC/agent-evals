+func readCompletedFilter(r *http.Request) (*bool, bool) {
+	values, exists := r.URL.Query()["completed"]
+	if !exists {
+		return nil, true
+	}
+	if len(values) != 1 {
+		return nil, false
+	}
+
+	var completed bool
+	switch values[0] {
+	case "true":
+		completed = true
+	case "false":
+		completed = false
+	default:
+		return nil, false
+	}
+	return &completed, true
+}
