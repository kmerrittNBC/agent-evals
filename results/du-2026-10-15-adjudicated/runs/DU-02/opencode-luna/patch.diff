+func TestTodoListRejectsInvalidCompletionFilters(t *testing.T) {
+	handler := newAPIHandler(newTestStore(t))
+	for _, query := range []string{
+		"completed=",
+		"completed=maybe",
+		"completed=TRUE",
+		"completed=1",
+		"completed=true&completed=false",
+	} {
+		performRequest[map[string]string](t, handler, http.MethodGet, "/api/todos?"+query, "", http.StatusBadRequest)
+	}
+
+	request := httptest.NewRequest(http.MethodGet, "/api/todos", nil)
+	request.URL.RawQuery = "completed=%ZZ"
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	if response.Code != http.StatusBadRequest {
+		t.Fatalf("malformed completion filter status = %d, want %d", response.Code, http.StatusBadRequest)
+	}
+}
+
+func assertTodoIDs(t *testing.T, todos []Todo, expected ...int64) {
+	t.Helper()
+	if len(todos) != len(expected) {
+		t.Fatalf("todo count = %d, want %d; todos: %+v", len(todos), len(expected), todos)
+	}
+	for i, todo := range todos {
+		if todo.ID != expected[i] {
+			t.Fatalf("todo ID at index %d = %d, want %d; todos: %+v", i, todo.ID, expected[i], todos)
+		}
+	}
+}
