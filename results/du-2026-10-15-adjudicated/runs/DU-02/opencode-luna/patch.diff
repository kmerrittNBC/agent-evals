+func (s *Store) ListFiltered(completed *bool) ([]Todo, error) {
+	query := `SELECT id, title, completed, created_at, updated_at FROM todos`
+	var rows *sql.Rows
+	var err error
+	if completed == nil {
+		rows, err = s.db.Query(query + ` ORDER BY id`)
+	} else {
+		rows, err = s.db.Query(query+` WHERE completed = ? ORDER BY id`, *completed)
+	}
 	if err != nil {
 		return nil, fmt.Errorf("list todos: %w", err)
 	}
