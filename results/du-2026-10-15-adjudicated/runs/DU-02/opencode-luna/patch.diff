+func TestTodoListCompletionFilterPreservesUnfilteredOrder(t *testing.T) {
+	handler := newAPIHandler(newTestStore(t))
+	created := []Todo{
+		performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"First open"}`, http.StatusCreated),
+		performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"First done","completed":true}`, http.StatusCreated),
+		performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"Second open"}`, http.StatusCreated),
+		performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"Second done","completed":true}`, http.StatusCreated),
+	}
+
+	all := performRequest[[]Todo](t, handler, http.MethodGet, "/api/todos", "", http.StatusOK)
+	open := performRequest[[]Todo](t, handler, http.MethodGet, "/api/todos?completed=false", "", http.StatusOK)
+	done := performRequest[[]Todo](t, handler, http.MethodGet, "/api/todos?completed=true", "", http.StatusOK)
+	assertTodoIDs(t, all, created[0].ID, created[1].ID, created[2].ID, created[3].ID)
+	assertTodoIDs(t, open, created[0].ID, created[2].ID)
+	assertTodoIDs(t, done, created[1].ID, created[3].ID)
+	for i, todo := range all {
+		if todo.Completed != (i%2 == 1) {
+			t.Errorf("todo %d completed = %t, want %t", todo.ID, todo.Completed, i%2 == 1)
+		}
+	}
+
+	// Listing with a filter is read-only; the unfiltered list still contains all todos.
+	all = performRequest[[]Todo](t, handler, http.MethodGet, "/api/todos", "", http.StatusOK)
+	assertTodoIDs(t, all, created[0].ID, created[1].ID, created[2].ID, created[3].ID)
+	for i, todo := range all {
+		if todo.Completed != (i%2 == 1) {
+			t.Errorf("todo %d completed after filtering = %t, want %t", todo.ID, todo.Completed, i%2 == 1)
+		}
+	}
+}
