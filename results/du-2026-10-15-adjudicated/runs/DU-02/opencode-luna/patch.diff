+func readCompletedFilter(r *http.Request) (*bool, bool) {
+	query, err := url.ParseQuery(r.URL.RawQuery)
+	if err != nil {
+		return nil, false
+	}
+	values, present := query["completed"]
+	if !present {
+		return nil, true
+	}
+	if len(values) != 1 {
+		return nil, false
+	}
+
+	var completed bool
+	switch values[0] {
+	case "true":
+		completed = true
+	case "false":
+		completed = false
+	default:
+		return nil, false
+	}
+	return &completed, true
+}
