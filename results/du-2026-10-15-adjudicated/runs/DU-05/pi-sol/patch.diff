+    def test_pack_status_rejects_malformed_repo_facts(self):
+        base = {
+            "reference_answer": "Answer", "sources": [{
+                "title": "Source", "url": "https://example.test", "retrieved_at": "2026-10-15",
+                "snapshot_or_excerpt": "Excerpt"}],
+            "ambiguities": [], "grading_guidance": {
+                "must_check": [], "acceptable_alternatives": [], "do_not_penalize": []},
+            "decision_changing_errors": [],
+        }
+        malformed = [None, {}, "facts", [None], ["fact"], [{}],
+                     [{"repo": "relayview"}], [{"commit": "a" * 40}],
+                     [{"repo": "", "commit": "a" * 40}],
+                     [{"repo": "   ", "commit": "a" * 40}],
+                     [{"repo": 1, "commit": "a" * 40}],
+                     [{"repo": "relayview", "commit": None}],
+                     [{"repo": "relayview", "commit": "a" * 39}],
+                     [{"repo": "relayview", "commit": "g" * 40}],
+                     [{"repo": "relayview", "commit": 123}],
+                     [{"repo": "relayview", "commit": "a" * 40}, {}]]
+        manifest = {"repos": {"relayview": {"path": "/tmp/relayview", "commit": "a" * 40}}}
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / "pack.json"
+            with patch("src.agent_eval.core.pack_path", return_value=path):
+                for facts in malformed:
+                    path.write_text(json.dumps({**base, "repo_facts": facts}))
+                    for pinned in (None, manifest):
+                        with self.subTest(facts=facts, pinned=pinned is not None):
+                            okay, reason = pack_status("IG-02", pinned)
+                            self.assertFalse(okay)
+                            self.assertIn("repo fact", reason)
+
+    def test_pack_status_compares_well_formed_repo_pins(self):
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / "pack.json"
+            pack = {
+                "reference_answer": "Answer", "sources": [{
+                    "title": "Source", "url": "https://example.test", "retrieved_at": "2026-10-15",
+                    "snapshot_or_excerpt": "Excerpt"}],
+                "repo_facts": [{"repo": "relayview", "commit": "a" * 40}],
+                "ambiguities": [], "grading_guidance": {
+                    "must_check": [], "acceptable_alternatives": [], "do_not_penalize": []},
+                "decision_changing_errors": [],
+            }
+            path.write_text(json.dumps(pack))
+            manifest = {"repos": {"relayview": {"path": "/tmp/relayview", "commit": "a" * 40}}}
+            with patch("src.agent_eval.core.pack_path", return_value=path):
+                self.assertEqual(pack_status("IG-02", manifest), (True, "ready"))
+                manifest["repos"]["relayview"]["commit"] = "b" * 40
+                self.assertEqual(pack_status("IG-02", manifest),
+                                 (False, "judge evidence pack repo pin differs for relayview"))
+
