+func TestDeleteTodoPersistsWhenStoreReopens(t *testing.T) {
+	databasePath := filepath.Join(t.TempDir(), "todos.db")
+	store, err := NewStore(databasePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	handler := newAPIHandler(store)
+	removed := performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"Remove me"}`, http.StatusCreated)
+	kept := performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"Keep me"}`, http.StatusCreated)
+	path := "/api/todos/" + strconv.FormatInt(removed.ID, 10)
+
+	request := httptest.NewRequest(http.MethodDelete, path, nil)
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	if response.Code != http.StatusNoContent || response.Body.Len() != 0 {
+		t.Fatalf("DELETE status = %d, body = %q; want 204 and empty body", response.Code, response.Body.String())
+	}
+	performRequest[map[string]string](t, handler, http.MethodGet, path, "", http.StatusNotFound)
+	performRequest[map[string]string](t, handler, http.MethodDelete, path, "", http.StatusNotFound)
+	listed := performRequest[[]Todo](t, handler, http.MethodGet, "/api/todos", "", http.StatusOK)
+	if len(listed) != 1 || listed[0].ID != kept.ID {
+		t.Fatalf("list after delete = %+v, want only %+v", listed, kept)
+	}
+	if err := store.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	reopened, err := NewStore(databasePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reopened.Close()
+	if _, err := reopened.Get(removed.ID); !errors.Is(err, errTodoNotFound) {
+		t.Fatalf("deleted todo after reopening: %v, want not found", err)
+	}
+	listed, err = reopened.List()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(listed) != 1 || listed[0].ID != kept.ID {
+		t.Fatalf("list after reopening = %+v, want only %+v", listed, kept)
+	}
 }
 
