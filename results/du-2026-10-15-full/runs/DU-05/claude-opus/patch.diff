+    def test_malformed_repo_facts_are_not_ready(self):
+        pin = "a" * 40
+        manifest = {"repos": {"relayview": {"path": "/tmp/relayview", "commit": pin}}}
+        base = {"reference_answer": "Answer",
+                "sources": [{"title": "t", "url": "repo://relayview/pin/file",
+                             "retrieved_at": "2026-10-15", "snapshot_or_excerpt": "e"}],
+                "ambiguities": [], "decision_changing_errors": [],
+                "grading_guidance": {"must_check": [], "acceptable_alternatives": [],
+                                     "do_not_penalize": []}}
+        malformed = {"missing commit": [{"repo": "relayview"}],
+                     "missing repo": [{"commit": pin}],
+                     "empty repo": [{"repo": " ", "commit": pin}],
+                     "non-string repo": [{"repo": 7, "commit": pin}],
+                     "short commit": [{"repo": "relayview", "commit": "abc123"}],
+                     "non-hex commit": [{"repo": "relayview", "commit": "z" * 40}],
+                     "non-string commit": [{"repo": "relayview", "commit": None}],
+                     "non-object fact": ["relayview"],
+                     "non-list facts": {"relayview": pin}}
+        cases = [(name, facts, False) for name, facts in malformed.items()]
+        cases += [("well-formed", [{"repo": "relayview", "commit": pin}], True),
+                  ("wrong pin", [{"repo": "relayview", "commit": "b" * 40}], False)]
+        with tempfile.TemporaryDirectory() as temp:
+            path = Path(temp) / "pack.json"
+            for name, facts, ready in cases:
+                with self.subTest(case=name), patch("src.agent_eval.core.pack_path", return_value=path):
+                    path.write_text(json.dumps({**base, "repo_facts": facts}))
+                    for current in (manifest, None):
+                        okay, reason = pack_status("IG-02", current)
+                        if ready:
+                            self.assertEqual((okay, reason), (True, "ready"))
+                        elif name == "wrong pin":
+                            expected = ((False, "judge evidence pack repo pin differs for relayview")
+                                        if current else (True, "ready"))
+                            self.assertEqual((okay, reason), expected)
+                        else:
+                            self.assertFalse(okay)
+                            self.assertIn("malformed repo fact", reason)
+
