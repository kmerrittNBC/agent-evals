+func TestDeletedTodoStaysAbsentAfterStoreReopens(t *testing.T) {
+	databasePath := filepath.Join(t.TempDir(), "todos.db")
+	store, err := NewStore(databasePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	handler := newAPIHandler(store)
+	created := performRequest[Todo](t, handler, http.MethodPost, "/api/todos", `{"title":"Remove permanently"}`, http.StatusCreated)
+
+	request := httptest.NewRequest(http.MethodDelete, "/api/todos/"+strconv.FormatInt(created.ID, 10), nil)
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	if response.Code != http.StatusNoContent {
+		t.Fatalf("DELETE status = %d, want %d; body: %s", response.Code, http.StatusNoContent, response.Body.String())
+	}
+	if response.Body.Len() != 0 {
+		t.Fatalf("DELETE response body = %q, want empty", response.Body.String())
+	}
+	assertTodoAbsent(t, handler, created.ID)
+	if err := store.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	reopened, err := NewStore(databasePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reopened.Close()
+	assertTodoAbsent(t, newAPIHandler(reopened), created.ID)
+}
+
+func TestDeleteMissingTodoReturnsNotFound(t *testing.T) {
+	handler := newAPIHandler(newTestStore(t))
+	request := httptest.NewRequest(http.MethodDelete, "/api/todos/99", nil)
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	if response.Code != http.StatusNotFound {
+		t.Fatalf("DELETE status = %d, want %d; body: %s", response.Code, http.StatusNotFound, response.Body.String())
+	}
+}
+
+func assertTodoAbsent(t *testing.T, handler http.Handler, id int64) {
+	t.Helper()
+	listed := performRequest[[]Todo](t, handler, http.MethodGet, "/api/todos", "", http.StatusOK)
+	for _, todo := range listed {
+		if todo.ID == id {
+			t.Fatalf("deleted todo %d remains in list: %+v", id, listed)
+		}
+	}
+	performRequest[map[string]string](t, handler, http.MethodGet, "/api/todos/"+strconv.FormatInt(id, 10), "", http.StatusNotFound)
+}
