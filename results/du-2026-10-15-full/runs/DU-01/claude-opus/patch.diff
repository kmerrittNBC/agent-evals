+func performDelete(t *testing.T, handler http.Handler, path string, expectedStatus int) {
+	t.Helper()
+
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, httptest.NewRequest(http.MethodDelete, path, nil))
+
+	if response.Code != expectedStatus {
+		t.Fatalf("DELETE %s status = %d, want %d; body: %s", path, response.Code, expectedStatus, response.Body.String())
+	}
+	if expectedStatus == http.StatusNoContent && response.Body.Len() != 0 {
+		t.Fatalf("DELETE %s body = %q, want empty", path, response.Body.String())
+	}
+}
