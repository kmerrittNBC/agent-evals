+func TestDeletedTodoStaysGoneWhenStoreReopens(t *testing.T) {
+	databasePath := filepath.Join(t.TempDir(), "todos.db")
+	store, err := NewStore(databasePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	kept, err := store.Create(todoInput{Title: "Keep after restart"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	deleted, err := store.Create(todoInput{Title: "Delete before restart"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	performDelete(t, newAPIHandler(store), fmt.Sprintf("/api/todos/%d", deleted.ID), http.StatusNoContent)
+	if err := store.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	reopened, err := NewStore(databasePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer reopened.Close()
+	if _, err := reopened.Get(deleted.ID); !errors.Is(err, errTodoNotFound) {
+		t.Fatalf("Get deleted todo after reopen error = %v, want %v", err, errTodoNotFound)
+	}
+	todos, err := reopened.List()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(todos) != 1 || todos[0].ID != kept.ID {
+		t.Fatalf("todos after reopen = %+v, want only %+v", todos, kept)
+	}
+}
+
