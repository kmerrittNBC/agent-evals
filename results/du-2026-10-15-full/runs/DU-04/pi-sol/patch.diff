diff --git a/src/agent_eval/core.py b/src/agent_eval/core.py
index 7fdb9d7..7f6eb5c 100644
--- a/src/agent_eval/core.py
+++ b/src/agent_eval/core.py
@@ -234,6 +234,8 @@ def tree_digest(root: Path) -> str:
     digest = hashlib.sha256()
     for path in sorted(root.rglob("*")):
         digest.update(str(path.relative_to(root)).encode())
+        if path.is_symlink():
+            digest.update(os.fsencode(os.readlink(path)))
         if path.is_file():
             digest.update(path.read_bytes())
     return digest.hexdigest()
