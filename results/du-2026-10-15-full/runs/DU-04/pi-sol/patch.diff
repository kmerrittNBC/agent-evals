+    def test_tree_digest_tracks_symlink_targets_even_when_broken(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            (root / "first").write_text("same content")
+            (root / "second").write_text("same content")
+            link = root / "link"
+            for first, second in (("first", "second"), ("missing-a", "missing-b")):
+                with self.subTest(targets=(first, second)):
+                    link.symlink_to(first)
+                    before = tree_digest(root)
+                    link.unlink()
+                    link.symlink_to(second)
+                    self.assertNotEqual(before, tree_digest(root))
+                    link.unlink()
+
+    def test_tree_digest_tracks_file_contents_and_paths(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            file = root / "first"
+            file.write_text("original")
+            before = tree_digest(root)
+            file.write_text("modified")
+            self.assertNotEqual(before, tree_digest(root))
+            changed = tree_digest(root)
+            file.rename(root / "second")
+            self.assertNotEqual(changed, tree_digest(root))
+
