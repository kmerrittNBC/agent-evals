+    def test_repo_assignments_reject_repeated_names_and_pin_single_assignment(self):
+        with tempfile.TemporaryDirectory() as temp:
+            repos = []
+            for name in ("first", "second"):
+                repo = Path(temp) / name
+                repo.mkdir()
+                subprocess.run(["git", "init", "-q", str(repo)], check=True)
+                subprocess.run(["git", "-C", str(repo), "-c", "user.name=Eval",
+                                "-c", "user.email=eval@example.test", "commit", "-qm",
+                                "pin", "--allow-empty"], check=True)
+                repos.append(repo)
+            commit = subprocess.check_output(
+                ["git", "-C", str(repos[0]), "rev-parse", "HEAD"], text=True).strip()
+            assignment = f"relayview={repos[0]}"
+            self.assertEqual(validate_repos([assignment]), {
+                "relayview": {"path": str(repos[0]), "commit": commit,
+                              "working_tree_dirty": False}})
+            for second in (assignment, f"relayview={repos[1]}"):
+                with self.subTest(second=second), self.assertRaisesRegex(
+                        ValueError, "Duplicate --repo assignment for relayview"):
+                    validate_repos([assignment, second])
+
