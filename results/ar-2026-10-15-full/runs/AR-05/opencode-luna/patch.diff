+    def test_archive_workspace_provider_owns_temporary_lifecycle(self):
+        with ArchiveWorkspaceProvider().open({}, {"repos": []}) as workspace:
+            path = workspace.path
+            self.assertTrue(path.is_dir())
+            unchanged, after = workspace.verify_integrity()
+            self.assertTrue(unchanged)
+            self.assertEqual(workspace.snapshot_digest_before, after)
+        self.assertFalse(path.exists())
+
+    def test_runner_keeps_conversation_contract_behind_workspace_seam(self):
+        class FakeWorkspace:
+            path: Path
+            snapshot_digest_before = "same-tree"
+
+            def verify_integrity(self):
+                return True, "same-tree"
+
+        class FakeProvider:
+            def __init__(self, path):
+                self.path = path
+                self.closed = False
+
+            @contextmanager
+            def open(self, repos, task):
+                workspace = FakeWorkspace()
+                workspace.path = self.path
+                try:
+                    yield workspace
+                finally:
+                    self.closed = True
+
