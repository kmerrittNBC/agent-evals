+
+    def test_workspace_factory_owns_integrity_policy_and_record(self):
+        events = []
+
+        class WritableWorkspace:
+            def __init__(self, task, manifest):
+                self.temporary = tempfile.TemporaryDirectory()
+                self.path = Path(self.temporary.name)
+
+            def __enter__(self):
+                events.append("enter")
+                return self
+
+            def __exit__(self, *exc_info):
+                events.append("exit")
+                self.temporary.cleanup()
+
+            def verify(self):
+                events.append("verify")
+                return None
+
+            def record(self):
+                return {"workspace_changes": sorted(p.name for p in self.path.iterdir())}
+
+        def fake_capture(cmd, cwd, env, timeout, events_path):
+            self.assertEqual(env["AGENT_EVAL_WORKSPACE"], str(cwd))
+            (cwd / "fix.py").write_text("pass")
+            return _phase([{"type": "text", "part": {"text": "Changed fix.py."}}], 1.0)
+
+        with patch.object(core, "capture", side_effect=fake_capture):
+            metrics = run_one(OPENCODE_ARM, self.task, self.manifest, "eval",
+                              workspace_factory=WritableWorkspace)
+        self.assertEqual(events, ["enter", "verify", "exit"])
+        self.assertEqual(metrics["status"], "completed")
+        self.assertEqual(metrics["workspace_changes"], ["fix.py"])
+        self.assertNotIn("snapshot_digest_before", metrics)
+
+    def test_snapshot_workspace_cleans_up_when_export_fails(self):
+        workspace = core.SnapshotWorkspace({"relayview": {"path": "/nonexistent", "commit": "0" * 40}},
+                                           ["relayview"])
+        with patch.object(core, "prepare_workspace", side_effect=RuntimeError("git archive failed")):
