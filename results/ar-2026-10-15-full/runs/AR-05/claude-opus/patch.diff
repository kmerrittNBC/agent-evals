+class SnapshotWorkspace:
+    """Read-only export of the task's pinned commits in a temporary directory.
+
+    A workspace owns creation, the post-run integrity check, and cleanup; the
+    harness conversation only sees ``path``. ``verify`` returns a failure
+    reason or None, and ``record`` returns the fields it adds to metrics.
+    """
+
+    def __init__(self, repos: dict[str, dict], repo_names: list[str]):
+        self.repos = repos
+        self.repo_names = repo_names
+        self._temporary: tempfile.TemporaryDirectory | None = None
+        self.path = Path()
+        self.before: str | None = None
+        self.after: str | None = None
+
+    def __enter__(self) -> SnapshotWorkspace:
+        self._temporary = tempfile.TemporaryDirectory(prefix="agent-eval-")
+        try:
+            self.path = Path(self._temporary.name) / "workspace"
+            prepare_workspace(self.repos, {"repos": self.repo_names}, self.path)
+            self.before = tree_digest(self.path)
+        except BaseException:
+            self._temporary.cleanup()
+            raise
+        return self
+
+    def __exit__(self, *exc_info: Any) -> None:
+        if self._temporary is not None:
+            self._temporary.cleanup()
+
+    def verify(self) -> str | None:
+        self.after = tree_digest(self.path)
+        return None if self.after == self.before else "Repository snapshot was modified"
+
+    def record(self) -> dict:
+        return {"snapshot_digest_before": self.before, "snapshot_digest_after": self.after}
+
+
+def snapshot_workspace(task: dict, manifest: dict) -> SnapshotWorkspace:
+    return SnapshotWorkspace(manifest["repos"], task_repo_names(task, manifest))
+
+
+def converse(arm: dict, prompts: list[str], workspace: Path, run_dir: Path,
+             env: dict[str, str], timeout: int) -> dict:
+    """Run the prompt and, only after a clarifying question, the continuation.
+
+    Writes per-phase transcripts to run_dir and returns merged events, phase
+    results, the final answer, and the session used for continuation.
+    """
+    session = None
+    all_events: list[dict] = []
+    phase_results: list[dict] = []
+    asked = False
+    answer = ""
+    for phase, prompt in enumerate(prompts):
+        if phase and not asked:
+            break
+        event_path = run_dir / f"phase-{phase}.jsonl"
+        cmd = adapters.command(arm, prompt, workspace, run_dir, session)
+        if arm["harness"] == "copilot" and phase == 0:
+            import uuid
+            cmd[cmd.index("--session-id") + 1] = str(uuid.uuid4())
+        result = capture(cmd, workspace, env, timeout, event_path)
+        phase_results.append({key: value for key, value in result.items() if key != "events"})
+        offset = sum(item["elapsed_seconds"] for item in phase_results[:-1])
+        for entry in result["events"]:
+            entry["index"] = len(all_events)
+            entry["elapsed_seconds"] += offset
+            entry["phase"] = phase
+            all_events.append(entry)
+        answer = adapters.final_answer(arm["harness"], result["events"])
+        if phase == 0:
+            asked = adapters.asked_question(result["events"], answer)
+            session = adapters.session_id(arm["harness"], result["events"])
+            if arm["harness"] == "copilot":
+                session = cmd[cmd.index("--session-id") + 1]
+            if arm["harness"] == "pi":
+                session = str(run_dir / "pi-session.jsonl")
+        if result["exit_code"] != 0 or result["timed_out"]:
+            break
+        if phase == 0 and asked and not session:
+            break
+    return {"events": all_events, "phases": phase_results, "answer": answer,
+            "asked": asked, "session": session}
+
+
+def run_status(conversation: dict, workspace_failure: str | None) -> tuple[str, str | None]:
+    last = conversation["phases"][-1]
+    if workspace_failure:
+        return "failed", workspace_failure
+    if last["timed_out"]:
+        return "timeout", "Harness exceeded timeout"
+    if last["exit_code"] != 0:
+        return "failed", f"Harness exited {last['exit_code']}"
+    if conversation["asked"] and not conversation["session"]:
+        return "failed", "Clarification asked but session continuation was unavailable"
+    if not conversation["answer"]:
+        return "failed", "No final answer parsed from events"
+    return "completed", None
+
+
