+    def test_failed_first_phase_does_not_continue(self):
+        with patch.object(core, "capture", return_value=_phase(
+                [{"type": "text", "sessionID": "s", "part": {"text": "Which platform?"}}], 1.0, exit_code=2)) as fake:
+            metrics = run_one(OPENCODE_ARM, self.task, self.manifest, "eval")
+        self.assertEqual(fake.call_count, 1)
