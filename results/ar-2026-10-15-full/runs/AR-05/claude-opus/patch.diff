+OPENCODE_ARM = {"id": "opencode-luna", "harness": "opencode", "binary": "opencode",
+                "model": "github-copilot/gpt-6-luna", "reasoning": "medium",
+                "search_provider": "tinyfish"}
+
+
+def _phase(events: list[dict], elapsed: float, exit_code: int = 0) -> dict:
+    return {"events": [{"index": i, "elapsed_seconds": float(i), "channel": "stdout", "data": data}
+                       for i, data in enumerate(events)],
+            "exit_code": exit_code, "timed_out": False, "elapsed_seconds": elapsed,
+            "started_at": "2026-10-15T00:00:00+00:00"}
+
+
+class RunOneContractTests(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.results = Path(temp.name)
+        patcher = patch.object(core, "RESULTS", self.results)
+        patcher.start()
+        self.addCleanup(patcher.stop)
+        self.task = {"id": "IG-T", "prompt": "Which release is current?", "repos": []}
+        self.manifest = {"preflight": {"opencode-luna": {"status": "ready"}}, "repos": {}}
+
+    def test_clarification_continues_session_and_merges_phases(self):
+        calls = []
+
+        def fake_capture(cmd, cwd, env, timeout, events_path):
+            calls.append({"cmd": cmd, "cwd": cwd, "events_path": events_path})
+            if len(calls) == 1:
+                return _phase([{"type": "step_start", "sessionID": "sess-1", "part": {}},
+                               {"type": "text", "sessionID": "sess-1", "part": {"text": "Which platform?"}}], 2.5)
+            return _phase([{"type": "text", "sessionID": "sess-1", "part": {"text": "Release 2 is current."}},
+                           {"type": "step_finish", "sessionID": "sess-1",
+                            "part": {"tokens": {"input": 3, "output": 4}}}], 1.5)
+
+        with patch.object(core, "capture", side_effect=fake_capture):
+            metrics = run_one(OPENCODE_ARM, self.task, self.manifest, "eval")
+        run_dir = self.results / "eval/runs/IG-T/opencode-luna"
+        self.assertEqual(len(calls), 2)
+        self.assertEqual(calls[0]["cmd"][-1], "Which release is current?")
+        self.assertEqual(calls[1]["cmd"][-1], read_config("run-policy")["continuation_response"])
+        self.assertEqual(calls[1]["cmd"][calls[1]["cmd"].index("--session") + 1], "sess-1")
+        self.assertEqual([c["events_path"].name for c in calls], ["phase-0.jsonl", "phase-1.jsonl"])
+        self.assertEqual(calls[0]["cwd"], calls[1]["cwd"])
+        self.assertFalse(calls[0]["cwd"].exists(), "workspace must be removed after the run")
+        self.assertEqual((metrics["status"], metrics["reason"]), ("completed", None))
+        self.assertTrue(metrics["asked_clarification"])
+        self.assertEqual(metrics["continuations"], 1)
+        self.assertEqual(metrics["elapsed_seconds"], 4.0)
+        self.assertEqual(metrics["answer"], "Release 2 is current.")
+        self.assertEqual(metrics["first_visible_seconds"], 1.0)
+        self.assertEqual(metrics["usage"]["raw"], {"tokens": {"input": 3, "output": 4}})
+        self.assertEqual(metrics["snapshot_digest_before"], metrics["snapshot_digest_after"])
+        self.assertEqual([p["elapsed_seconds"] for p in metrics["phases"]], [2.5, 1.5])
+        self.assertTrue(all("events" not in p for p in metrics["phases"]))
+        events = [json.loads(line) for line in (run_dir / "events.jsonl").read_text().splitlines()]
+        self.assertEqual([e["index"] for e in events], [0, 1, 2, 3])
+        self.assertEqual([e["phase"] for e in events], [0, 0, 1, 1])
+        self.assertEqual([e["elapsed_seconds"] for e in events], [0.0, 1.0, 2.5, 3.5])
+        self.assertEqual((run_dir / "answer.md").read_text(), "Release 2 is current.\n")
+        self.assertEqual(json.loads((run_dir / "metrics.json").read_text()), metrics)
+
+    def test_modified_snapshot_fails_even_with_an_answer(self):
