+    def test_run_conversation_contract_and_workspace_integrity(self):
+        arm = {"id": "opencode-test", "harness": "opencode", "binary": "opencode",
+               "model": "provider/model", "reasoning": "medium"}
+        task = {"id": "task", "repos": ["repo"], "prompt": "First prompt"}
+        manifest = {"repos": {}, "preflight": {arm["id"]: {"status": "ready"}}}
+        for modify in (False, True):
+            with self.subTest(modify=modify), tempfile.TemporaryDirectory() as temp, \
+                 patch("src.agent_eval.core.RESULTS", Path(temp)), \
+                 patch("src.agent_eval.core.prepare_workspace") as prepare, \
+                 patch("src.agent_eval.core.capture") as capture:
+                def make_workspace(repos, selected, destination):
+                    self.assertEqual(selected, {"repos": ["repo"]})
+                    destination.mkdir()
+                    (destination / "source.txt").write_text("pinned")
+
+                prepare.side_effect = make_workspace
+                workspaces = []
+
+                def fake_capture(command, cwd, env, timeout, event_path):
+                    phase = len(workspaces)
+                    workspaces.append(cwd)
+                    self.assertEqual(command[-1], "First prompt" if phase == 0 else
+                                     read_config("run-policy")["continuation_response"])
+                    self.assertEqual(env["AGENT_EVAL_WORKSPACE"], str(cwd))
+                    self.assertEqual(event_path.name, f"phase-{phase}.jsonl")
+                    if phase == 1:
+                        self.assertEqual(command[command.index("--session") + 1], "sess-1")
+                        if modify:
+                            (cwd / "source.txt").write_text("changed")
+                    events = [{"index": 0, "elapsed_seconds": 0.25, "channel": "stdout",
+                               "data": {"type": "text", "sessionID": "sess-1", "part": {
